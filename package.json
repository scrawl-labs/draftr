{
  "name": "@scrawl-labs/draftr",
  "version": "0.1.0",
  "description": "Diagrams for AI agents: the model says what, draftr decides where. Auto layout to Excalidraw/SVG/PNG plus a deterministic diagram linter, as a CLI and an MCP server.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "bin": {
    "draftr": "./dist/cli.js",
    "draftr-mcp": "./dist/mcp.js"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "fonts",
    "README.md",
    "LICENSE"
  ],
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist",
    "prepublishOnly": "pnpm clean && pnpm build",
    "icons": "node scripts/build-icons.mjs",
    "fonts": "node scripts/build-fonts.mjs"
  },
  "keywords": [
    "mcp",
    "diagram",
    "excalidraw",
    "mermaid",
    "layout",
    "elk",
    "lint",
    "architecture",
    "sequence-diagram",
    "claude",
    "icons"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/scrawl-labs/draftr.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "elkjs": "^0.12.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource/nunito": "^5.3.0",
    "@types/node": "^22.20.5",
    "lucide-static": "^1.72.0",
    "pretendard": "^1.3.9",
    "simple-icons": "^16.37.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "peerDependencies": {
    "playwright": ">=1.40"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    }
  },
  "homepage": "https://github.com/scrawl-labs/draftr#readme",
  "bugs": {
    "url": "https://github.com/scrawl-labs/draftr/issues"
  }
}
