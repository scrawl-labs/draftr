datasource db { provider = "postgresql" url = env("DATABASE_URL") }
model User {
  id    Int    @id @default(autoincrement())
  email String @unique
  posts Post[]
}
model Post {
  id       Int    @id
  title    String
  author   User   @relation(fields: [authorId], references: [id])
  authorId Int
  tags     Tag[]
}
model Tag {
  id    Int    @id
  name  String
  posts Post[]
}
